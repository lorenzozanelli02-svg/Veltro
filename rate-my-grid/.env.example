# Copy to .env.local for local development. Every value is optional locally:
# without keys the app runs on mock AI, a mock Instagram lookup, mock payments and in-memory storage.
# In production, mocks are switched off unless DEMO_MODE=true.

# Public URL of the site (used for metadata and links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI analysis ---
# Anthropic API key. Server only: never prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Which Claude model scores accounts.
ANTHROPIC_MODEL=claude-opus-5-5
# How hard the model thinks: low, medium, high (default), xhigh or max. Fixed so every account gets the same depth.
ANALYSIS_EFFORT=high
# Only used by older models that accept it (e.g. claude-sonnet-4-6). Claude Opus 5.5 rejects a temperature.
ANALYSIS_TEMPERATURE=0

# --- Instagram username lookup (Apify) ---
# Apify API token: console.apify.com > Settings > API & Integrations. Server only: never prefix it with NEXT_PUBLIC_.
APIFY_TOKEN=
# The Apify actor that reads public profiles. Default: Apify's Instagram Profile Scraper.
APIFY_ACTOR_ID=apify~instagram-profile-scraper
# That actor's price per profile in US dollars, from its Apify Store page, so the cost log includes it.
APIFY_COST_PER_RESULT_USD=
# Hard ceiling on what a single lookup run may be charged.
APIFY_MAX_CHARGE_PER_LOOKUP_USD=0.05
# How long to wait for a lookup before switching the visitor to screenshot upload.
LOOKUP_TIMEOUT_MS=60000
# Most lookups that reach Apify per day across all visitors: a ceiling on the Apify bill.
DAILY_LOOKUP_CAP=200

# --- Payments (connected in a later step) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Storage and rate limits (connected in a later step) ---
# Vercel's Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN for you;
# a database created directly at upstash.com uses these names instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Most analyses allowed per day across all visitors: a ceiling on API spend.
DAILY_ANALYSIS_CAP=300

# --- Score tester (/admin/test) ---
# A long random string to enter on the hidden test page. Without it the page only works locally.
ADMIN_TOKEN=

# --- Development helpers ---
# Use mock AI even when ANTHROPIC_API_KEY is set (saves API costs while working on the UI).
MOCK_AI=false
# Use the mock lookup even when APIFY_TOKEN is set, and how long it pretends to take (ms).
# Mock usernames that fail on purpose: private.account, no.such.account, slow.account, broken.account,
# incomplete.account (fails the data check)
MOCK_LOOKUP=false
MOCK_LOOKUP_DELAY_MS=2500
# Mock analysis delay in ms, and a forced result to test the error screens: not_instagram or unreadable.
MOCK_AI_DELAY_MS=5000
MOCK_AI_RESULT=
# Allow mocks in a production build, e.g. a Vercel preview for showing the flow. Never on the live site.
DEMO_MODE=false
